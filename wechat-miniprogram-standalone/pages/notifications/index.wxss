.read-all{min-height:66rpx;padding:0 16rpx;color:#1769ff;font-size:23rpx;font-weight:800}.tabs{margin:18rpx -28rpx 0;padding:0 28rpx;white-space:nowrap;box-sizing:border-box}.tabs-row{display:inline-flex;gap:10rpx}.tab{min-height:70rpx;padding:0 26rpx;border-radius:99rpx;color:#72809a;background:#fff;font-size:23rpx;font-weight:800}.tab.selected{color:#fff;background:#1769ff}.notice{display:grid;grid-template-columns:70rpx 1fr auto;align-items:center;width:100%;gap:18rpx;margin-top:16rpx;padding:24rpx;border:1rpx solid #e7edf6;border-radius:28rpx;background:#fff;text-align:left;box-shadow:0 10rpx 30rpx rgba(28,65,121,.06);box-sizing:border-box}.notice.unread{border-color:#c8d9ff;background:#fbfdff}.notice-icon{display:flex;align-items:center;justify-content:center;width:66rpx;height:66rpx;border-radius:22rpx;color:#1769ff;background:#eaf2ff;font-weight:900}.notice-icon.reminder{color:#ad5b00;background:#fff2df}.notice-icon.system{color:#087d72;background:#e7fbf7}.notice-main{display:flex;flex-direction:column;gap:8rpx;min-width:0}.notice-main>view{display:flex;align-items:center;gap:10rpx}.notice-content{display:-webkit-box;overflow:hidden;color:#596983;font-size:23rpx;line-height:1.5;-webkit-box-orient:vertical;-webkit-line-clamp:2}.unread-dot{width:14rpx;height:14rpx;border-radius:50%;background:#ff4358}.arrow{color:#a5b0bf;font-size:40rpx}.demo-note{margin-top:22rpx;padding:20rpx;border-radius:20rpx;color:#72809a;background:#eef2f7;font-size:22rpx;line-height:1.5}
