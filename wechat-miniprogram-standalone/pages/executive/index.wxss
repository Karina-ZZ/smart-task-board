.executive-hero{display:flex;align-items:center;justify-content:space-between;margin-top:24rpx;padding:34rpx;border-radius:38rpx;color:#fff;background:radial-gradient(circle at 84% 12%,rgba(8,169,154,.7),transparent 33%),linear-gradient(145deg,#071d3d,#133d77);box-shadow:0 22rpx 50rpx rgba(7,29,61,.2)}.executive-hero>view:first-child{display:flex;flex-direction:column}.hero-kicker{color:#9fc7f2;font-size:22rpx;font-weight:800;letter-spacing:3rpx}.hero-number{margin-top:8rpx;font-size:72rpx;font-weight:900;line-height:1.1}.hero-sub{margin-top:8rpx;color:#cfe0f4;font-size:21rpx}.donut{display:flex;align-items:center;justify-content:center;width:148rpx;height:148rpx;border-radius:50%;background:conic-gradient(#68eadb calc(var(--score)*1%),rgba(255,255,255,.14) 0)}.donut>view{display:flex;flex-direction:column;align-items:center;justify-content:center;width:110rpx;height:110rpx;border-radius:50%;background:#133c70}.donut .bold{font-size:34rpx}.donut text{color:#bed3ee;font-size:18rpx}.exec-metrics{margin-top:18rpx}.teal{color:#08a99a}.heatmap{padding:10rpx 20rpx}.heat-head,.heat-row{display:grid;grid-template-columns:1.7fr .8fr .5fr .5fr;align-items:center;min-height:76rpx;text-align:center}.heat-head{color:#72809a;font-size:21rpx}.heat-head>text:first-child{text-align:left}.heat-row{width:100%;border-top:1rpx solid #edf1f6;font-size:23rpx}.heat-row>view{display:flex;align-items:center;gap:12rpx;text-align:left}.heat-row>view>view{display:flex;flex-direction:column}.heat-row>view>view text{color:#72809a;font-size:18rpx}.mini-avatar{display:flex;align-items:center;justify-content:center;width:48rpx;height:48rpx;border-radius:16rpx;color:#fff;background:#1769ff;font-weight:900}.heat-score{display:inline-flex;align-items:center;justify-content:center;min-height:50rpx;border-radius:16rpx;color:#ad5b00;background:#fff2df;font-weight:900}.heat-score.high{color:#c52c42;background:#ffedf0}.heat-score.low{color:#087d72;background:#e7fbf7}.legend{display:flex;justify-content:flex-end;gap:18rpx;margin-top:14rpx;color:#72809a;font-size:19rpx}.legend text{display:flex;align-items:center;gap:6rpx}.legend view{width:12rpx;height:12rpx;border-radius:50%;background:#ff9718}.legend view.low{background:#08a99a}.legend view.high{background:#ff4358}.denied{display:flex;flex-direction:column;align-items:center;gap:18rpx;margin-top:60rpx;text-align:center}.denied-mark{display:flex;align-items:center;justify-content:center;width:100rpx;height:100rpx;border-radius:32rpx;color:#72809a;background:#eef2f7;font-size:30rpx;font-weight:900}.denied .btn{width:100%;margin-top:10rpx}
