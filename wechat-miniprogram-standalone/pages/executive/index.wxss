.executive-page{overflow-x:hidden}.exec-head{margin:-32rpx -28rpx 18rpx;padding:36rpx 28rpx 30rpx;background:radial-gradient(circle at 88% 8%,rgba(8,169,154,.28),transparent 34%),linear-gradient(145deg,#071d3d,#0d2d5b);color:#fff}.exec-title-row .title{display:block;margin-top:4rpx;font-size:40rpx;font-weight:900}.exec-title-row .subtitle{display:block;margin-top:6rpx;color:#b9cee8;font-size:21rpx}.exec-filters{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(0,1fr);gap:14rpx;margin-top:24rpx}.filter-select{display:flex;align-items:center;justify-content:space-between;min-height:72rpx;padding:0 20rpx;border:1rpx solid rgba(255,255,255,.16);border-radius:20rpx;background:#18375e;color:#fff;font-size:22rpx}.period-tabs{display:grid;grid-template-columns:1fr 1fr;padding:6rpx;border-radius:20rpx;background:rgba(255,255,255,.1)}.period-tab{min-width:0;border:0;border-radius:15rpx;background:transparent;color:#c7d8eb;font-size:22rpx}.period-tab.active{background:#fff;color:#1769ff;font-weight:900}.exec-metrics{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14rpx;margin-bottom:28rpx}.mini-metric{margin:0;padding:24rpx}.mini-metric>text:first-child{color:#72809a;font-size:22rpx}.metric-number{display:block;margin-top:8rpx;color:#1769ff;font-size:42rpx;font-weight:900;line-height:1.1}.metric-number.teal{color:#08a99a}.metric-note{display:block;min-height:32rpx;margin-top:8rpx;color:#8490a4;font-size:19rpx}.quadrant-grid{display:grid;grid-template-columns:1fr 1fr;gap:14rpx;margin-bottom:28rpx}.quadrant-card{display:grid;grid-template-columns:18rpx 1fr 22rpx;align-items:center;gap:12rpx;min-height:118rpx;padding:20rpx;border:0;border-radius:26rpx;text-align:left}.quadrant-card.danger{background:#fff0f2}.quadrant-card.warning{background:#fff6ea}.quadrant-card.amber{background:#fff9e9}.quadrant-card.teal{background:#eafaf8}.quad-dot{width:14rpx;height:62rpx;border-radius:99rpx;background:#ff4358}.warning .quad-dot{background:#ff9718}.amber .quad-dot{background:#ffad14}.teal .quad-dot{background:#08a99a}.quad-count{display:block;color:#11203a;font-size:38rpx;font-weight:900;line-height:1}.quad-label{display:block;margin-top:8rpx;color:#647087;font-size:21rpx;font-weight:700}.quad-arrow{color:#91a0b7;font-size:34rpx}.heat-title{margin-top:4rpx}.heat-scroll{box-sizing:border-box;width:100%;padding:18rpx;overflow:hidden}.heat-table{width:max-content;min-width:100%}.heat-header,.heat-line{display:grid;grid-template-columns:150rpx repeat(var(--day-count),82rpx);align-items:center;gap:8rpx;min-height:76rpx}.member-head,.day-head{color:#72809a;font-size:19rpx;text-align:center}.member-head{text-align:left}.day-head text{display:block;color:#a0aabb;font-size:16rpx}.member-cell{display:flex;align-items:center;gap:10rpx;min-width:0}.mini-avatar{display:flex;align-items:center;justify-content:center;width:44rpx;height:44rpx;flex:0 0 auto;border-radius:14rpx;background:#1769ff;color:#fff;font-size:20rpx;font-weight:900}.member-cell>view{display:flex;min-width:0;flex-direction:column}.member-name{overflow:hidden;font-size:20rpx;font-weight:800;text-overflow:ellipsis;white-space:nowrap}.member-no{color:#8b96aa;font-size:16rpx}.heat-cell{display:flex;align-items:center;justify-content:center;width:74rpx;height:58rpx;border:0;border-radius:14rpx;color:#fff;font-size:20rpx;font-weight:900}.heat-cell.idle{background:#74cdbf}.heat-cell.normal{background:#5c91db}.heat-cell.busy{background:#ff9718}.heat-cell.overloaded{background:#ff4358}.heat-cell.empty{background:#edf2f8;color:#a4afc0}.heat-cell[disabled]{opacity:1}.legend{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:12rpx 18rpx;margin:12rpx 4rpx 22rpx;color:#72809a;font-size:18rpx}.legend text{display:flex;align-items:center;gap:6rpx}.legend view{width:12rpx;height:12rpx;border-radius:50%}.legend .idle{background:#74cdbf}.legend .normal{background:#5c91db}.legend .busy{background:#ff9718}.legend .overloaded{background:#ff4358}.quality-hint{margin:10rpx 0 24rpx;padding:18