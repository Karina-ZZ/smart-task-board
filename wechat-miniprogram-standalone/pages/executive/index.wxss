00}.snapshot-facts{display:grid;grid-template-columns:repeat(4,1fr);gap:8rpx;margin-top:18rpx}.snapshot-facts text{padding:14rpx 6rpx;border-radius:16rpx;background:#f4f7fc;color:#647087;font-size:18rpx;text-align:center}.sheet-boundary{display:block;margin-top:20rpx;color:#8b96aa;font-size:18rpx;text-align:center}

