<view class="page no-nav decomposition-page"><view class="safe-top"></view><view class="topbar topbar-left"><button class="back" bindtap="back">‹</button><view><text class="eyebrow">AI DECOMPOSITION</text><text class="title">任务智能拆解</text></view></view>
  <view class="decomp-hero {{state}}"><view class="ai-core">✦<view class="core-ring"></view></view><text class="decomp-title">{{state === 'processing' ? '正在把任务变成行动' : state === 'succeeded' ? '拆解完成，任务已生效' : '拆解暂未完成'}}</text><text class="decomp-sub">{{state === 'processing' ? '离开本页不会取消任务，刷新后会从服务端恢复进度' : state === 'succeeded' ? ((attempt && attempt.nodeCount) || 0) + ' 个节点已通过校验并写入' : (error || '你可以重新发起拆解')}}</text></view>
  <view class="card stage-card"><view wx:for="{{stages}}" wx:key="*this" class="stage {{index < stageIndex || state === 'succeeded' ? 'done' : index === stageIndex && state === 'processing' ? 'active' : ''}}"><text class="stage-mark">{{index < stageIndex || state === 'succeeded' ? '✓' : index + 1}}</text><text>{{item}}</text><text>{{index < stageIndex || state === 'succeeded' ? '已完成' : index === stageIndex && state === 'processing' ? '处理中' : '等待'}}</text></view></view>
  <view class="notice"><text>拆解成功前，任务不会计入负荷，也不能汇报、完成节点或验收。</text></view>
  <view class="sticky-actions"><button wx:if="{{state === 'failed'}}" class="btn btn-primary" loading="{{retrying}}" disabled="{{retrying}}" bindtap="retry">重新拆解</button><button wx:elif="{{state === 'succeeded'}}" class="btn btn-primary" bindtap="detail">查看执行节点</button><button wx:else class="btn btn-secondary" disabled>AI处理中，请稍候</button></view>
</view>
