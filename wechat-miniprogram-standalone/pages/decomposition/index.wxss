.decomposition-page{background:radial-gradient(circle at 50% 8%,#dceaff,transparent 34%)}.decomp-hero{display:flex;flex-direction:column;align-items:center;margin-top:48rpx;text-align:center}.ai-core{position:relative;display:flex;align-items:center;justify-content:center;width:150rpx;height:150rpx;border-radius:50%;color:#fff;background:linear-gradient(135deg,#1769ff,#08a99a);box-shadow:0 0 0 18rpx rgba(23,105,255,.08),0 20rpx 42rpx rgba(23,105,255,.22);font-size:56rpx}.core-ring{position:absolute;inset:-22rpx;border:3rpx dashed rgba(23,105,255,.35);border-radius:50%}.failed .ai-core{background:#ff4358}.succeeded .ai-core{background:#08a99a}.decomp-title{margin-top:38rpx;font-size:36rpx;font-weight:900}.decomp-sub{max-width:580rpx;margin-top:12rpx;color:#72809a;font-size:24rpx;line-height:1.6}.stage-card{margin-top:36rpx}.stage{display:grid;grid-template-columns:48rpx 1fr auto;align-items:center;gap:16rpx;min-height:84rpx;color:#9aa6b7}.stage>text:last-child{font-size:21rpx}.stage-mark{display:flex;align-items:center;justify-content:center;width:46rpx;height:46rpx;border-radius:50%;background:#eef1f6;font-size:21rpx;font-weight:900}.stage.active{color:#1769ff;font-weight:800}.stage.active .stage-mark{color:#fff;background:#1769ff}.stage.done{color:#087d72}.stage.done .stage-mark{color:#fff;background:#08a99a}.notice{margin-top:22rpx;padding:22rpx;border-radius:22rpx;color:#52617a;background:#eef2f8;font-size:23rpx;line-height:1.55}
