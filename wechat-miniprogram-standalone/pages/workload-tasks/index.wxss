.member-card{margin-top:22rpx;padding:30rpx;border-radius:36rpx;background:#fff;box-shadow:0 18rpx 50rpx rgba(28,65,121,.09)}.member-head{display:grid;grid-template-columns:80rpx 1fr auto;align-items:center;gap:18rpx}.member-avatar{display:flex;align-items:center;justify-content:center;width:78rpx;height:78rpx;border-radius:26rpx;color:#fff;background:linear-gradient(135deg,#1769ff,#08a99a);font-size:30rpx;font-weight:900}.member-head>view:nth-child(2){display:flex;flex-direction:column;gap:6rpx}.member-name{font-size:32rpx;font-weight:900}.member-meta{color:#72809a;font-size:22rpx}.score{display:flex;flex-direction:column;align-items:flex-end}.score .bold{color:#ff9718;font-size:44rpx}.score text{color:#72809a;font-size:19rpx}.pressure{margin-top:20rpx}.pressure>view:first-child{display:flex;align-items:center;justify-content:space-between;margin-bottom:10rpx;font-size:23rpx}.pressure .bold{color:#1769ff}.progress-fill.red{background:#ff4358}.scope-note{padding:20rpx;border-radius:20rpx;color:#52617a;background:#eef2f8;font-size:22rpx;line-height:1.5}
