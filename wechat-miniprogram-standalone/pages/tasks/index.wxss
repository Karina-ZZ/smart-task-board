.task-overview-page { background: #f4f7fc; }
.overview-header { display: flex; align-items: center; justify-content: space-between; min-height: 104rpx; }
.overview-title { display: block; font-size: 40rpx; font-weight: 900; letter-spacing: -1rpx; }
.overview-subtitle { display: block; margin-top: 8rpx; color: #72809a; font-size: 23rpx; }
.notification-button { position: relative; display: flex; align-items: center; justify-content: center; width: 70rpx; height: 70rpx; border-radius: 50%; color: #304463; background: #fff; box-shadow: 0 10rpx 28rpx rgba(28,65,121,.09); }
.notification-icon { font-size: 38rpx; transform: rotate(45deg); }
.notification-dot { position: absolute; top: 8rpx; right: 8rpx; width: 14rpx; height: 14rpx; border: 4rpx solid #fff; border-radius: 50%; background: #ff4358; }

.overview-counts { width: 100%; margin-top: 18rpx; white-space: nowrap; }
.overview-count-row { display: inline-flex; gap: 16rpx; padding: 2rpx 2rpx 12rpx; }
.overview-count { display: flex; width: 214rpx; min-height: 154rpx; padding: 24rpx; flex-direction: column; align-items: flex-start; justify-content: space-between; border: 2rpx solid #e7edf6; border-radius: 26rpx; color: #72809a; background: #fff; text-align: left; box-sizing: border-box; box-shadow: 0 10rpx 28rpx rgba(28,65,121,.05); }
.overview-count text:first-child { font-size: 22rpx; }
.overview-count .count-number { color: #1769ff; font-size: 48rpx; font-weight: 900; line-height: 1; }
.overview-count.active { border-color: #1769ff; background: #edf4ff; box-shadow: 0 14rpx 32rpx rgba(23,105,255,.12); }

.overview-panel { margin-top: 14rpx; padding: 28rpx; border: 1rpx solid #e7edf6; border-radius: 30rpx; background: #fff; box-shadow: 0 16rpx 44rpx rgba(28,65,121,.07); }
.overview-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }
.toolbar-copy { display: flex; min-width: 0; flex-direction: column; gap: 8rpx; }
.panel-title { font-size: 30rpx; font-weight: 900; }
.title-icon { color: #1769ff; }
.result-count { color: #72809a; font-size: 22rpx; }
.filter-button { display: flex; align-items: center; justify-content: center; min-height: 68rpx; padding: 0 20rpx; gap: 8rpx; border: 2rpx solid #c8d8f3; border-radius: 20rpx; color: #1769ff; background: #fff; font-size: 22rpx; font-weight: 800; }

.mode-tabs { display: grid; grid-template-columns: repeat(2,1fr); gap: 8rpx; margin-top: 24rpx; padding: 8rpx; border-radius: 22rpx; background: #edf1f7; }
.mode-tab { min-height: 70rpx; border-radius: 17rpx; color: #72809a; font-size: 23rpx; font-weight: 800; }
.mode-tab.active { color: #1769ff; background: #fff; box-shadow: 0 8rpx 20rpx rgba(35,49,76,.08); }
.quick-status { margin: 20rpx -28rpx 0; padding: 0 28rpx; white-space: nowrap; }
.quick-status-row { display: inline-flex; gap: 12rpx; padding-right: 28rpx; }
.quick-chip { display: inline-flex; align-items: center; justify-content: center; min-height: 64rpx; padding: 0 22rpx; border: 1rpx solid #e1e8f3; border-radius: 18rpx; color: #68758b; background: #f5f7fb; font-size: 22rpx; font-weight: 700; }
.quick-chip.active { border-color: #1769ff; color: #1769ff; background: #eaf1ff; font-weight: 900; }
.summary-row { display: flex; align-items: flex-start; justify-content: space-between; margin-top: 20rpx; gap: 16rpx; }
.filter-summary { display: flex; min-width: 0; flex: 1; flex-wrap: wrap; gap: 10rpx; }
.summary-badge { padding: 8rpx 14rpx; border-radius: 99rpx; color: #24508d; background: #edf4ff; font-size: 20rpx; font-weight: 700; }
.all-visible { color: #8a96aa; font-size: 21rpx; line-height: 52rpx; }
.reset-link { min-height: 52rpx; flex: 0 0 auto; color: #1769ff; font-size: 21rpx; font-weight: 800; }

.overview-loading { display: grid; gap: 16rpx; margin-top: 20rpx; }
.skeleton { height: 180rpx; border-radius: 24rpx; background: linear-gradient(90deg,#f0f3f8,#f8fafd,#f0f3f8); background-size: 200% 100%; animation: skeleton 1.3s infinite linear; }
.skeleton.wide { height: 80rpx; }
@keyframes skeleton { from { background-position: 100% 0; } to { background-position: -100% 0; } }
.overview-empty { display: flex; min-height: 310rpx; padding: 36rpx 20rpx; flex-direction: column; align-items: center; justify-content: center; text-align: center; }
.empty-mark { color: #b7c5d8; font-size: 64rpx; }
.empty-title { margin-top: 14rpx; font-size: 27rpx; font-weight: 900; }
.empty-detail { margin-top: 10rpx; color: #72809a; font-size: 22rpx; line-height: 1.5; }
.empty-action { min-height: 66rpx; margin-top: 24rpx; padding: 0 24rpx; border: 2rpx solid #bad0ff; border-radius: 20rpx; color: #1769ff; background: #f5f8ff; font-size: 22rpx; font-weight: 800; }

.overview-node-card { display: block; width: 100%; margin-top: 18rpx; padding: 24rpx; border: 1rpx solid #e7edf6; border-radius: 26rpx; background: #fff; text-align: left; box-shadow: 0 12rpx 32rpx rgba(28,65,121,.06); box-sizing: border-box; }
.overview-node-card.overdue { border-color: #ffd0d7; background: #fffafa; }
.node-parent { display: block; overflow: hidden; color: #1769ff; font-size: 20rpx; font-weight: 800; text-overflow: ellipsis; white-space: nowrap; }
.node-head { display: flex; align-items: flex-start; justify-content: space-between; margin-top: 12rpx; gap: 16rpx; }
.node-name { flex: 1; font-size: 28rpx; font-weight: 900; line-height: 1.45; }
.node-status { flex: 0 0 auto; padding: 7rpx 14rpx; border-radius: 99rpx; color: #087d72; background: #e7fbf7; font-size: 20rpx; font-weight: 800; }
.overview-node-card .progress { margin-top: 20rpx; }
.node-meta { display: flex; margin-top: 14rpx; flex-wrap: wrap; gap: 10rpx 20rpx; color: #72809a; font-size: 20rpx; }
.pagination { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; margin-top: 28rpx; gap: 18rpx; color: #72809a; text-align: center; font-size: 22rpx; }
.page-button { min-height: 70rpx; border: 2rpx solid #d5e1f5; border-radius: 20rpx; color: #1769ff; background: #f7faff; font-weight: 800; }
.page-button[disabled] { opacity: .4; }

.filter-overlay { position: fixed; inset: 0; z-index: 100; display: flex; align-items: flex-end; justify-content: center; background: rgba(6,18,37,.45); }
.filter-sheet { display: flex; width: 100%; max-height: 86vh; flex-direction: column; overflow: hidden; border-radius: 42rpx 42rpx 0 0; background: #fff; box-shadow: 0 -20rpx 60rpx rgba(6,18,37,.18); animation: sheet-up .22s ease-out; }
@keyframes sheet-up { from { transform: translateY(60rpx); opacity: .5; } }
.sheet-handle { width: 82rpx; height: 8rpx; margin: 18rpx auto 10rpx; border-radius: 99rpx; background: #d8dee8; }
.sheet-head { display: flex; align-items: center; justify-content: space-between; padding: 10rpx 28rpx 18rpx; }
.sheet-title { font-size: 34rpx; font-weight: 900; }
.sheet-close { display: flex; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; border-radius: 20rpx; color: #60708a; background: #f2f5f9; font-size: 36rpx; }
.sheet-content { min-height: 0; flex: 1; padding: 0 28rpx; box-sizing: border-box; }
.filter-group { padding: 24rpx 0; border-bottom: 1rpx solid #e7edf6; }
.filter-label { display: block; font-size: 25rpx; font-weight: 900; }
.filter-help { display: block; margin-top: 8rpx; color: #8a96aa; font-size: 20rpx; line-height: 1.45; }
.filter-options { display: flex; margin-top: 16rpx; flex-wrap: wrap; gap: 12rpx; }
.filter-choice { min-height: 62rpx; padding: 0 20rpx; border: 2rpx solid #e1e8f3; border-radius: 18rpx; color: #66738a; background: #f5f7fb; font-size: 21rpx; }
.filter-choice.active { border-color: #9cbcff; color: #1769ff; background: #eaf1ff; font-weight: 900; }
.filter-search { display: flex; align-items: center; min-height: 78rpx; margin-top: 14rpx; padding: 0 20rpx; gap: 12rpx; border: 2rpx solid #e1e8f3; border-radius: 20rpx; color: #72809a; background: #f9fbfe; }
.filter-search input { min-width: 0; height: 78rpx; flex: 1; color: #11203a; }
.switch-group { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.date-row,.sort-row { display: grid; grid-template-columns: repeat(2,1fr); gap: 14rpx; }
.date-row { margin-top: 18rpx; }
.sort-row picker { min-width: 0; }
.picker-field { display: flex; min-height: 100rpx; padding: 16rpx 18rpx; flex-direction: column; justify-content: center; gap: 10rpx; border: 2rpx solid #e1e8f3; border-radius: 20rpx; color: #72809a; background: #f9fbfe; font-size: 20rpx; box-sizing: border-box; }
.picker-value { overflow: hidden; color: #11203a; font-size: 22rpx; font-weight: 900; text-overflow: ellipsis; white-space: nowrap; }
.sheet-spacer { height: 30rpx; }
.sheet-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; padding: 18rpx 28rpx calc(22rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #e7edf6; background: #fff; }
.sheet-reset,.sheet-apply { min-height: 86rpx; border-radius: 24rpx; font-weight: 900; }
.sheet-reset { border: 2rpx solid #bad0ff; color: #1769ff; background: #f5f8ff; }
.sheet-apply { color: #fff; background: linear-gradient(135deg,#1769ff,#4b8cff); box-shadow: 0 14rpx 28rpx rgba(23,105,255,.2); }
