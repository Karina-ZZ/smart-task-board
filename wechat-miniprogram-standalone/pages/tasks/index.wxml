<view class="page task-overview-page">
  <view class="safe-top"></view>
  <view class="overview-header">
    <view><text class="overview-title">任务概览</text><text class="overview-subtitle">当前用户参与的任务</text></view>
    <button class="notification-button" bindtap="openNotifications" aria-label="打开通知"><text class="notification-icon">♢</text><text wx:if="{{unread}}" class="notification-dot"></text></button>
  </view>

  <scroll-view class="overview-counts" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="overview-count-row">
      <button wx:for="{{statusCards}}" wx:key="value" class="overview-count {{filters.mode === 'tasks' && filters.status === item.value ? 'active' : ''}}" data-status="{{item.value}}" bindtap="selectStatus">
        <text>{{item.label}}任务</text><text class="count-number">{{item.count || 0}}</text>
      </button>
    </view>
  </scroll-view>

  <view id="overview-task-section" class="overview-panel">
    <view class="overview-toolbar">
      <view class="toolbar-copy"><text class="panel-title"><text class="title-icon">▤</text> 任务信息管理</text><text class="result-count">{{filters.mode === 'nodes' ? '节点' : '任务'}}结果 {{total}} 项</text></view>
      <button class="filter-button" bindtap="openFilter"><text>⌁</text> 更多筛选</button>
    </view>

    <view class="mode-tabs">
      <button class="mode-tab {{filters.mode === 'tasks' ? 'active' : ''}}" data-mode="tasks" bindtap="setMode">主任务</button>
      <button class="mode-tab {{filters.mode === 'nodes' ? 'active' : ''}}" data-mode="nodes" bindtap="setMode">我的节点任务</button>
    </view>

    <scroll-view class="quick-status" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="quick-status-row"><button wx:for="{{quickStatuses}}" wx:key="value" class="quick-chip {{filters.mode === 'tasks' && filters.status === item.value ? 'active' : ''}}" data-status="{{item.value}}" bindtap="selectStatus">{{item.label}}</button></view>
    </scroll-view>

    <view class="summary-row">
      <view wx:if="{{filterSummary.length}}" class="filter-summary"><text wx:for="{{filterSummary}}" wx:key="*this" class="summary-badge">{{item}}</text></view>
      <text wx:else class="all-visible">当前显示全部可见任务</text>
      <button class="reset-link" bindtap="resetFilters">重置筛选</button>
    </view>

    <view wx:if="{{loading}}" class="overview-loading">
      <view class="skeleton wide"></view><view class="skeleton"></view><view class="skeleton"></view>
    </view>
    <view wx:elif="{{error}}" class="overview-empty"><text class="empty-mark">!</text><text class="empty-title">任务概览暂时无法加载</text><text class="empty-detail">{{error}}</text><button class="empty-action" bindtap="retry">重试</button></view>
    <view wx:elif="{{!items.length}}" class="overview-empty"><text class="empty-mark">○</text><text class="empty-title">当前筛选条件下暂无{{filters.mode === 'nodes' ? '节点' : '任务'}}</text><text class="empty-detail">清空筛选后可查看全部可见结果</text><button class="empty-action" bindtap="resetFilters">重置筛选</button></view>

    <block wx:elif="{{filters.mode === 'tasks'}}">
      <task-card wx:for="{{items}}" wx:key="taskId" task="{{item}}" bind:open="openTask" />
    </block>

    <block wx:else>
      <button wx:for="{{items}}" wx:key="nodeId" class="overview-node-card {{item.isOverdue ? 'overdue' : ''}}" data-task-id="{{item.taskId}}" data-node-id="{{item.nodeId}}" bindtap="openNode">
        <text class="node-parent">所属任务 · {{item.taskName}}</text>
        <view class="node-head"><text class="node-name">{{item.nodeName}}</text><text class="node-status">{{item.nodeStatusLabel}}</text></view>
        <view class="progress"><view class="progress-fill" style="width: {{item.progressPercent || 0}}%"></view></view>
        <view class="node-meta"><text>负责人 {{item.ownerName || '待分配'}}</text><text>截止 {{item.deadlineLabel}}</text><text>进度 {{item.progressPercent || 0}}%</text></view>
      </button>
    </block>

    <view wx:if="{{!loading && !error && maxPage > 1}}" class="pagination">
      <button class="page-button" disabled="{{filters.page <= 1}}" bindtap="previousPage">上一页</button>
      <text>{{filters.page}} / {{maxPage}}</text>
      <button class="page-button" disabled="{{filters.page >= maxPage}}" bindtap="nextPage">下一页</button>
    </view>
  </view>

  <bottom-nav active="tasks" executive="{{executive}}" unread="{{unread}}" />
</view>

<view wx:if="{{filterOpen}}" class="filter-overlay" bindtap="closeFilter">
  <view class="filter-sheet" catchtap="stopOverlay">
    <view class="sheet-handle"></view>
    <view class="sheet-head"><text class="sheet-title">任务筛选</text><button class="sheet-close" bindtap="closeFilter">×</button></view>
    <scroll-view class="sheet-content" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="filter-group">
        <text class="filter-label">搜索</text>
        <view class="filter-search"><text>⌕</text><input value="{{draftFilters.search}}" bindinput="inputSearch" placeholder="任务或节点名称" /></view>
      </view>
      <view class="filter-group">
        <text class="filter-label">任务类型</text>
        <view class="filter-options"><button class="filter-choice {{draftFilters.mode === 'tasks' ? 'active' : ''}}" data-value="tasks" bindtap="chooseDraftMode">主任务</button><button class="filter-choice {{draftFilters.mode === 'nodes' ? 'active' : ''}}" data-value="nodes" bindtap="chooseDraftMode">我的节点任务</button></view>
      </view>
      <view class="filter-group">
        <text class="filter-label">任务状态</text>
        <view class="filter-options"><button wx:for="{{statusOptions}}" wx:key="value" class="filter-choice {{draftFilters.status === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="chooseDraftStatus">{{item.label}}</button></view>
      </view>
      <view class="filter-group">
        <text class="filter-label">优先级四象限</text>
        <view class="filter-options"><button wx:for="{{quadrantOptions}}" wx:key="value" class="filter-choice {{draftFilters.quadrant === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="chooseDraftQuadrant">{{item.label}}</button></view>
      </view>
      <view class="filter-group switch-group"><view><text class="filter-label">仅看未来3天临期</text><text class="filter-help">不包含已完成、已归档、已取消或已撤回</text></view><switch checked="{{draftFilters.nearDue}}" color="#1769ff" bindchange="toggleNearDue" /></view>
      <view class="filter-group switch-group"><view><text class="filter-label">需要支持</text><text class="filter-help">仅查看存在未关闭卡点的任务</text></view><switch checked="{{draftFilters.support === 'open'}}" color="#1769ff" bindchange="toggleSupport" /></view>
      <view class="filter-group">
        <text class="filter-label">开始时间</text>
        <view class="filter-options"><button wx:for="{{dateOptions}}" wx:key="value" class="filter-choice {{draftFilters.datePreset === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="chooseDraftDatePreset">{{item.label}}</button></view>
        <view wx:if="{{draftFilters.datePreset === 'custom'}}" class="date-row"><picker mode="date" value="{{draftFilters.startDate}}" bindchange="chooseStartDate"><view class="picker-field"><text>开始日期</text><text class="picker-value">{{draftFilters.startDate || '请选择'}}</text></view></picker><picker mode="date" value="{{draftFilters.endDate}}" bindchange="chooseEndDate"><view class="picker-field"><text>结束日期</text><text class="picker-value">{{draftFilters.endDate || '请选择'}}</text></view></picker></view>
      </view>
      <view class="filter-group sort-row">
        <picker range="{{sortOptions}}" range-key="label" bindchange="chooseSort"><view class="picker-field"><text>排序</text><text class="picker-value">{{sortLabel}} ›</text></view></picker>
        <picker range="{{orderOptions}}" range-key="label" bindchange="chooseOrder"><view class="picker-field"><text>顺序</text><text class="picker-value">{{orderLabel}} ›</text></view></picker>
      </view>
      <view class="sheet-spacer"></view>
    </scroll-view>
    <view class="sheet-actions"><button class="sheet-reset" bindtap="resetFilters">重置</button><button class="sheet-apply" bindtap="applyDraftFilters">应用筛选</button></view>
  </view>
</view>
