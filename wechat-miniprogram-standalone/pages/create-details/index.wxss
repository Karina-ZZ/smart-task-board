.ai-note{display:flex;align-items:center;gap:16rpx;margin-top:20rpx;padding:22rpx;border-radius:24rpx;color:#24508d;background:#edf4ff}.ai-note>text{font-size:34rpx}.ai-note>view{display:flex;flex-direction:column;gap:6rpx}.form-card{margin-top:18rpx}.form-card>.field:first-child{margin-top:0}.short{min-height:130rpx}.two-col{display:grid;grid-template-columns:1fr 1fr;gap:16rpx}.weight-row{display:grid;grid-template-columns:repeat(5,1fr);gap:12rpx}.weight{display:flex;align-items:center;justify-content:center;min-height:74rpx;border:2rpx solid #e1e8f3;border-radius:20rpx;color:#72809a;background:#fff;font-weight:900}.weight.selected{border-color:#1769ff;color:#1769ff;background:#eaf2ff}
.ai-confidence{margin-top:4rpx;color:#1769ff;font-size:20rpx;font-weight:800}.clarification-card{margin-top:18rpx;border-color:#cfe0ff;background:linear-gradient(180deg,#f8fbff,#fff)}.clarification-head{display:flex;align-items:flex-start;justify-content:space-between;gap:18rpx}.clarification-head>view{display:flex;min-width:0;flex-direction:column;gap:6rpx}.question-count{flex:0 0 auto;padding:6rpx 12rpx;border-radius:99rpx;color:#1769ff;background:#eaf2ff;font-size:19rpx;font-weight:800}.question-row{display:grid;grid-template-columns:36rpx 1fr;gap:12rpx;margin-top:16rpx;align-items:start}.question-no{display:flex;align-items:center;justify-content:center;width:34rpx;height:34rpx;border-radius:50%;color:#fff;background:#1769ff;font-size:18rpx;font-weight:900}.question-text{padding-top:2rpx;color:#304463;font-size:22rpx;line-height:1.6}.clarification-input{margin-top:20rpx;min-height:150rpx}.clarify-button{width:100%;margin-top:16rpx}
.stepper{display:grid;grid-template-columns:auto 1fr auto 1fr auto;align-items:center;margin:2rpx 8rpx 18rpx;color:#9aa7b8}.stepper>view:not(.line){display:flex;align-items:center;justify-content:center;width:42rpx;height:42rpx;border-radius:50%;background:#edf1f6;font-size:20rpx;font-weight:900;position:relative}.stepper>view>text{position:absolute;top:49rpx;width:120rpx;text-align:center;font-size:18rpx;font-weight:700}.stepper .line{height:4rpx;background:#e2e8f0}.stepper .done,.stepper .active{color:#fff!important;background:#1769ff!important}.stepper .line.done{background:#1769ff}.source-card{margin-top:50rpx}.source-head{display:flex;align-items:center;justify-content:space-between}.text-btn{margin:0;padding:4rpx 8rpx;border:0;background:transparent;color:#1769ff;font-size:21rpx}.source-text{display:block;margin-top:12rpx;color:#46566f;font-size:23rpx;line-height:1.65}.menu-row{width:100%;margin:0;padding:20rpx 0;border:0;border-top:1rpx solid #edf1f6;border-radius:0;background:transparent;display:flex;align-items:center;gap:14rpx;text-align:left}.menu-icon{display:flex;align-items:center;justify-content:center;width:44rpx;height:44rpx;border-radius:14rpx;background:#eaf2ff;color:#1769ff;font-size:20rpx;font-weight:900}.menu-copy,.person-copy{min-width:0;flex:1;display:flex;flex-direction:column;gap:4rpx}.menu-value{max-width:190rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#304463;font-size:21rpx;font-weight:800}.compact{gap:12rpx}.chips{display:flex;gap:10rpx;flex-wrap:wrap;margin:0 0 16rpx}.chip{margin:0;padding:7rpx 16rpx;border:0;border-radius:999rpx;background:#eaf2ff;color:#1769ff;font-size:20rpx}.switch-row{display:flex;align-items:center;justify-content:space-between;padding:18rpx 0}.switch-row>view{display:flex;flex-direction:column;gap:4rpx}.split{display:grid;grid-template-columns:.8fr 1.2fr;gap:12rpx}.split .btn{width:100%;margin:0}.overlay{position:fixed;z-index:90;inset:0;background:rgba(6,18,37,.45);display:flex;align-items:flex-end}.sheet{width:100%;max-height:78vh;overflow:auto;background:#fff;border-radius:30rpx 30rpx 0 0;padding:18rpx 24rpx calc(30rpx + env(safe-area-inset-bottom));box-sizing:border-box}.sheet:before{content:"";display:block;width:80rpx;height:8rpx;border-radius:8rpx;background:#d8dee8;margin:0 auto 18rpx}.sheet-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:16rpx}.sheet-title{font-size:30rpx;font-weight:900}.close{margin:0;width:54rpx;height:54rpx;border:0;border-radius:16rpx;background:#f2f5f9;padding:0}.people-list{margin-top:16rpx}.person-row{width:100%;margin:0;padding:18rpx 0;border:0;border-bottom:1rpx solid #edf1f6;border-radius:0;background:transparent;display:flex;align-items:center;gap:14rpx;text-align:left}.avatar{display:flex;align-items:center;justify-content:center;width:58rpx;height:58rpx;border-radius:18rpx;background:#eaf2ff;color:#1769ff;font-weight:900}.load{padding:6rpx 10rpx;border-radius:999rpx;background:#fff1dd;color:#a65a00;font-size:18rpx;font-weight:800;white-space:nowrap}.load.high{background:#ffe9ec;color:#c43147}.load.low{background:#e9f8ef;color:#20864d}.empty{padding:36rpx 0;text-align:center;color:#8b99aa;font-size:22rpx}
