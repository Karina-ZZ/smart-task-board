.task-strip{display:flex;flex-direction:column;gap:12rpx;margin-top:18rpx;padding:24rpx;border-radius:26rpx;background:#edf4ff}.progress-title{display:flex;align-items:center;justify-content:space-between}.progress-number{color:#1769ff;font-size:44rpx;font-weight:900}.progress-scale{display:flex;justify-content:space-between;color:#9aa6b7;font-size:20rpx}.issue-switch{display:flex;align-items:center;justify-content:space-between;margin-top:28rpx;padding:22rpx;border-radius:22rpx;background:#f7f9fd}.issue-switch>view{display:flex;flex-direction:column}.issue-field{margin-top:20rpx;padding:22rpx;border:2rpx solid #ffd7dc;border-radius:24rpx;background:#fff7f8}.short{min-height:120rpx}.auto-note{margin-top:22rpx;padding:18rpx;border-radius:18rpx;color:#66758c;background:#f0f3f8;font-size:22rpx}
