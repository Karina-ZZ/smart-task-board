.task-card { display: block; width: 100%; margin-top: 18rpx; padding: 26rpx; border: 1rpx solid #e7edf6; border-radius: 28rpx; background: #fff; text-align: left; box-shadow: 0 14rpx 38rpx rgba(28,65,121,.07); box-sizing: border-box; }
.task-head, .task-meta, .task-foot { display: flex; align-items: center; }
.task-head, .task-foot { justify-content: space-between; }
.task-name { display: -webkit-box; overflow: hidden; margin-top: 18rpx; font-size: 30rpx; font-weight: 800; line-height: 1.45; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.task-no, .task-meta, .muted { color: #72809a; font-size: 22rpx; }
.task-meta { gap: 10rpx; margin-top: 14rpx; }
.progress { height: 10rpx; margin-top: 22rpx; overflow: hidden; border-radius: 99rpx; background: #e7edf6; }
.progress-fill { height: 100%; border-radius: inherit; background: linear-gradient(90deg,#1769ff,#08a99a); }
.task-foot { margin-top: 12rpx; }
.progress-label { color: #1769ff; font-size: 22rpx; font-weight: 800; }
.danger { color: #ff4358; }
