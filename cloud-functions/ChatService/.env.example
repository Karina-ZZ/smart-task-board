# Compatibility template. Prefer ../../config-examples/chatservice.env.example.
APP_ENV=development
CHAT_REQUIRE_AUTH=true
CHAT_SERVICE_JWT_SECRET_KEY=replace-with-same-value-as-fastapi-chat-service-secret
CHAT_SERVICE_JWT_ISSUER=smart-task-board
CHAT_SERVICE_JWT_AUDIENCE=wangxu-chat
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
QWEN_ASR_MODEL=
QWEN_TIMEOUT_SECONDS=30
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
