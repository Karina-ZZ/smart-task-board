# Compatibility example. Prefer config-examples/backend.env.example for new setups.
APP_NAME=Smart Task Board API
APP_ENV=development
APP_DEBUG=false
APP_TIMEZONE=Asia/Shanghai
LOG_LEVEL=INFO
POSTGRES_DB=smart_task_board
POSTGRES_USER=smart_task_board
POSTGRES_PASSWORD=change-me-before-starting-postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://smart_task_board:change-me-before-starting-postgres@localhost:5432/smart_task_board
AUTH_MODE=prototype
PROTOTYPE_AUTH_ENABLED=true
PROTOTYPE_USER_EMPLOYEE_NOS=E-CREATOR,E-ASSIGNEE,E-REVIEWER,E-OBSERVER
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ISSUER=smart-task-board
JWT_AUDIENCE=smart-task-board-web
JWT_EXPIRE_MINUTES=30
ALLOW_TEST_EMPLOYEE_HEADER=false
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Production WeCom Mini Program authentication (set AUTH_MODE=wecom)
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_APP_SECRET=
WECOM_API_BASE_URL=https://qyapi.weixin.qq.com
WECOM_REQUEST_TIMEOUT_SECONDS=8

# FastAPI -> ChatService short-lived task-intake token
CHAT_SERVICE_JWT_SECRET_KEY=
CHAT_SERVICE_JWT_ISSUER=smart-task-board
CHAT_SERVICE_JWT_AUDIENCE=wangxu-chat
CHAT_SERVICE_JWT_EXPIRE_MINUTES=5
