.review-page{background:linear-gradient(#eefaf7 0,transparent 460rpx)}.review-hero{display:flex;flex-direction:column;align-items:center;margin-top:24rpx;padding:34rpx;border-radius:34rpx;background:linear-gradient(145deg,#fff,#f0fffb);box-shadow:0 16rpx 44rpx rgba(8,169,154,.09);text-align:center}.review-title{margin-top:20rpx;font-size:34rpx;font-weight:900;line-height:1.45}.review-track{display:flex;align-items:center;justify-content:center;gap:8rpx;width:100%;margin-top:26rpx;color:#a0aaba;font-size:19rpx}.review-track view{padding:8rpx;border-radius:99rpx}.review-track .done{color:#087d72;background:#e7fbf7}.review-track .current{color:#1769ff;background:#eaf2ff;font-weight:900}.review-kv{display:flex;align-items:center;justify-content:space-between;margin-top:18rpx}.review-kv>text:first-child{color:#72809a}.next{display:block;margin-top:22rpx}.node-summary{display:grid;grid-template-columns:1fr auto 1fr auto;gap:14rpx;align-items:center}.node-summary text{color:#72809a}.node-summary .bold{color:#08a99a;font-size:34rpx}.archive-note{margin-top:22rpx;padding:22rpx;border-radius:22rpx;color:#087d72;background:#e7fbf7;font-size:23rpx;line-height:1.55}
