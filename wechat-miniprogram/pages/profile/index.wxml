<view class="page"><view class="safe-top"></view><view class="topbar"><view class="topbar-main"><text class="eyebrow">PROFILE</text><text class="title">我的</text><text class="subtitle">身份、任务关系与使用设置</text></view></view>
  <view class="profile-card"><view class="profile-avatar">{{avatarText}}</view><view><text class="profile-name">{{user.name}}</text><text class="profile-meta">{{user.employeeNo}} · {{user.departmentName}}</text><text class="badge {{executive ? 'blue' : 'green'}}">{{executive ? '高管权限' : '员工'}}</text></view></view>
  <view class="profile-metrics"><view><text class="bold">{{taskCount}}</text><text>关联任务</text></view><view><text class="bold">{{actionCount}}</text><text>待我处理</text></view><view><text class="bold">{{archivedCount}}</text><text>已归档</text></view></view>
  <view class="section-head"><text class="section-title">任务关系说明</text></view><view class="card relation"><view><text class="rel-icon blue">创</text><text>我创建的任务</text></view><view><text class="rel-icon teal">承</text><text>我主承办的任务</text></view><view><text class="rel-icon orange">协</text><text>我协同的任务</text></view><view><text class="rel-icon green">验</text><text>待我验收的任务</text></view></view>
  <view class="version">旺序AI任务中枢 · Mini Program V1.1</view>
  <bottom-nav active="profile" executive="{{executive}}" unread="{{unread}}" />
</view>
