.profile-card{display:flex;align-items:center;gap:24rpx;margin-top:24rpx;padding:34rpx;border-radius:36rpx;color:#fff;background:radial-gradient(circle at 88% 18%,rgba(75,140,255,.9),transparent 32%),linear-gradient(145deg,#071d3d,#123f7e);box-shadow:0 22rpx 50rpx rgba(7,29,61,.2)}.profile-avatar{display:flex;align-items:center;justify-content:center;width:112rpx;height:112rpx;flex:0 0 auto;border:6rpx solid rgba(255,255,255,.25);border-radius:50%;background:rgba(255,255,255,.12);font-size:42rpx;font-weight:900}.profile-card>view:last-child{display:flex;flex-direction:column;align-items:flex-start;gap:8rpx}.profile-name{font-size:36rpx;font-weight:900}.profile-meta{color:#c9dcf7;font-size:23rpx}.profile-metrics{display:grid;grid-template-columns:repeat(3,1fr);margin-top:20rpx;padding:24rpx;border:1rpx solid #e7edf6;border-radius:30rpx;background:#fff;box-shadow:0 12rpx 32rpx rgba(28,65,121,.07)}.profile-metrics>view{display:flex;flex-direction:column;align-items:center;gap:6rpx;border-right:1rpx solid #e7edf6}.profile-metrics>view:last-child{border:0}.profile-metrics .bold{color:#1769ff;font-size:38rpx}.profile-metrics text{color:#72809a;font-size:21rpx}.relation{display:grid;grid-template-columns:1fr 1fr;gap:16rpx}.relation>view{display:flex;align-items:center;gap:14rpx;padding:18rpx;border-radius:22rpx;background:#f7f9fd;font-size:23rpx}.rel-icon{display:flex;align-items:center;justify-content:center;width:48rpx;height:48rpx;border-radius:16rpx;color:#fff;background:#1769ff;font-weight:900}.rel-icon.teal{background:#08a99a}.rel-icon.orange{background:#ff9718}.rel-icon.green{background:#2bae64}.demo-tools{padding:10rpx 26rpx}.demo-tools>view{display:flex;align-items:center;justify-content:space-between;padding:22rpx 0;border-bottom:1rpx solid #e7edf6}.demo-tools>view:last-child{border:0}.demo-tools>view>view{display:flex;flex-direction:column}.mini-btn{min-height:66rpx;padding:0 18rpx;border-radius:20rpx;color:#1769ff;background:#eaf2ff;font-size:22rpx;font-weight:800}.mini-btn.danger{color:#ff4358;background:#fff0f2}.version{padding:38rpx 0;text-align:center;color:#a0abba;font-size:21rpx}
