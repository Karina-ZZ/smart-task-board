.confirm-hero{display:flex;flex-direction:column;align-items:center;margin-top:34rpx;text-align:center}.send-mark{display:flex;align-items:center;justify-content:center;width:112rpx;height:112rpx;border-radius:36rpx;color:#fff;background:linear-gradient(135deg,#1769ff,#08a99a);box-shadow:0 16rpx 34rpx rgba(23,105,255,.23);font-size:52rpx;font-weight:900}.confirm-title{margin-top:22rpx;font-size:36rpx;font-weight:900}.confirm-sub{max-width:600rpx;margin-top:10rpx;color:#72809a;font-size:24rpx;line-height:1.6}.confirm-head{display:flex;align-items:flex-start;justify-content:space-between;gap:18rpx}.confirm-name{font-size:32rpx;line-height:1.45}.description{display:block;margin-top:16rpx;color:#596983;line-height:1.65}.kv{display:grid;grid-template-columns:142rpx 1fr;gap:18rpx;margin-top:18rpx;font-size:25rpx;line-height:1.5}.kv>text:first-child{color:#72809a}.kv>text:last-child{text-align:right;font-weight:700}.flow-note{display:flex;align-items:flex-start;justify-content:space-between;gap:10rpx;margin-top:24rpx;padding:24rpx;border-radius:28rpx;background:#edf4ff;color:#24508d;font-size:20rpx}.flow-note>view{display:flex;flex:1;flex-direction:column;align-items:center;gap:8rpx;text-align:center}.flow-index{display:flex;align-items:center;justify-content:center;width:38rpx;height:38rpx;border-radius:50%;color:#fff;background:#1769ff;font-weight:900}
.stepper{display:grid;grid-template-columns:auto 1fr auto 1fr auto;align-items:center;margin:2rpx 8rpx 68rpx;color:#9aa7b8}.stepper>view:not(.line){display:flex;align-items:center;justify-content:center;width:42rpx;height:42rpx;border-radius:50%;background:#edf1f6;font-size:20rpx;font-weight:900;position:relative}.stepper>view>text{position:absolute;top:49rpx;width:120rpx;text-align:center;font-size:18rpx}.stepper .line{height:4rpx;background:#e2e8f0}.stepper .done,.stepper .active{color:#fff;background:#1769ff}.stepper .line.done{background:#1769ff}.recipient-note{display:flex;gap:15rpx;margin-top:18rpx;padding:20rpx;border:2rpx solid #cfe0ff;border-radius:22rpx;background:#f7faff;color:#24508d}.recipient-note>view{display:flex;flex-direction:column;gap:4rpx}.success-wrap{min-height:80vh;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:30rpx}.success-mark{display:flex;align-items:center;justify-content:center;width:110rpx;height:110rpx;border-radius:50%;background:#e9f8ef;color:#20864d;font-size:54rpx;font-weight:900}.success-title{margin-top:24rpx;font-size:38rpx;font-weight:900}.success-copy{margin:20rpx 0 34rpx;max-width:560rpx;color:#52637a;font-size:23rpx;line-height:1.7}.success-wrap .btn{width:100%;margin-top:12rpx}
