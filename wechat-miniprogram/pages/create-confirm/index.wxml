<view class="page no-nav"><view class="safe-top"></view>
  <block wx:if="{{!sentTask}}"><view class="topbar topbar-left"><button class="back" bindtap="back">‹</button><view><text class="eyebrow">CREATE · 3/3</text><text class="title">确认发送</text></view></view>
  <view class="stepper"><view class="done">1<text>描述任务</text></view><view class="line done"></view><view class="done">2<text>信息确认</text></view><view class="line done"></view><view class="active">3<text>确认发送</text></view></view>
  <view class="confirm-hero"><view class="send-mark">✓</view><text class="confirm-title">任务信息已完整</text><text class="confirm-sub">发送后进入“待接受”；只通知主承办人，不生成节点、不计入当前负荷。</text></view>
  <view class="card"><view class="confirm-head"><text class="strong confirm-name">{{draft.taskName}}</text><text class="badge orange">待接受</text></view><text class="description">{{draft.taskDescription}}</text><view class="line"></view><view class="kv"><text>任务目标</text><text>{{draft.taskGoal}}</text></view><view class="kv"><text>任务来源</text><text>{{draft.taskSource}}</text></view><view class="kv"><text>绩效指标</text><text>{{draft.performanceMetric || '不关联'}}</text></view><view class="kv"><text>主承办人</text><text>{{assigneeName}}</text></view><view class="kv"><text>汇报对象</text><text>{{reportToName}}</text></view><view class="kv"><text>协同人</text><text>{{collaboratorNames}}</text></view><view class="kv"><text>验收人</text><text>{{reviewerName}}</text></view><view class="kv"><text>开始时间</text><text>{{startLabel}}</text></view><view class="kv"><text>截止时间</text><text>{{deadlineLabel}}</text></view><view class="kv"><text>任务权重</text><text>{{draft.taskWeight}} / 5</text></view><view class="kv"><text>突发任务</text><text>{{draft.isUrgent ? '是' : '否'}}</text></view><view class="kv"><text>汇报周期</text><text>{{draft.reportCycle || '每周'}}</text></view><view class="kv"><text>验收标准</text><text>{{draft.acceptanceCriteria || '—'}}</text></view></view>
  <view class="recipient-note"><text>↗</text><view><text class="strong">本次待承办信息仅发送给 {{assigneeName}}</text><text class="muted small">其他任务相关人员按后续事件规则收取信息；管理员全局查看权限不会订阅任务通知。</text></view></view>
  <view class="flow-note"><view><text class="flow-index">1</text><text>确认发送</text></view><text>→</text><view><text class="flow-index">2</text><text>主承办人接受</text></view><text>→</text><view><text class="flow-index">3</text><text>AI拆解生效</text></view></view>
  <view class="sticky-actions"><button class="btn btn-primary" loading="{{sending}}" disabled="{{sending}}" bindtap="send">确认发送给 {{assigneeName}}</button></view></block>
  <block wx:else><view class="success-wrap"><view class="success-mark">✓</view><text class="success-title">任务已发送</text><text class="muted">{{sentTask.taskNo}}</text><text class="success-copy">已发送给主承办人 {{assigneeName}}，当前状态为“待接受”。接受前不会生成节点。</text><button class="btn btn-primary" bindtap="goDetail">查看任务详情</button><button class="btn btn-secondary" bindtap="goWorkbench">返回工作台</button></view></block>
</view>
