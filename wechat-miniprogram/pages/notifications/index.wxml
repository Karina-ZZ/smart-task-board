<view class="page"><view class="safe-top"></view><view class="topbar"><view class="topbar-main"><text class="eyebrow">NOTIFICATIONS</text><text class="title">通知中心</text><text class="subtitle">任务、提醒与系统消息</text></view></view>
  <scroll-view class="tabs" scroll-x><view class="tabs-row"><button wx:for="{{tabs}}" wx:key="code" class="tab {{type === item.code ? 'selected' : ''}}" data-type="{{item.code}}" bindtap="tab">{{item.label}}</button></view></scroll-view>
  <view wx:if="{{!visible.length}}" class="card empty"><text class="empty-mark">○</text><text>当前分类暂无消息</text></view>
  <button wx:for="{{visible}}" wx:key="notificationId" class="notice {{item.actionRequired ? 'unread' : ''}}" data-id="{{item.notificationId}}" bindtap="open"><view class="notice-icon {{item.type}}">{{item.type === 'task' ? '任' : item.type === 'reminder' ? '醒' : '系'}}</view><view class="notice-main"><view><text class="strong">{{item.title}}</text><text wx:if="{{item.actionRequired}}" class="unread-dot"></text><text wx:if="{{item.actionRequired}}" class="badge orange">待处理</text></view><text class="notice-content">{{item.content}}</text><text wx:if="{{item.canOpen === false}}" class="notice-unavailable">{{item.unavailableReason || '当前已无法打开'}}</text><text class="muted small">{{item.sentAt}}</text></view><text class="arrow">›</text></button>
  <bottom-nav active="notifications" executive="{{executive}}" unread="{{unread}}" />
</view>
