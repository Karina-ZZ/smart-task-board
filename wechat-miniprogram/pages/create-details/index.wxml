<view class="page no-nav">
  <view class="safe-top"></view>
  <view class="topbar topbar-left"><button class="back" bindtap="back">‹</button><view><text class="eyebrow">CREATE · 2/3</text><text class="title">确认任务信息</text></view></view>
  <view class="stepper"><view class="done">1<text>描述任务</text></view><view class="line done"></view><view class="active">2<text>信息确认</text></view><view class="line"></view><view>3<text>确认发送</text></view></view>
  <view class="card source-card"><view class="source-head"><text class="strong">✦ 原始任务描述</text><button class="text-btn" bindtap="editSource">返回修改</button></view><text class="source-text">{{draft.rawText || draft.taskDescription}}</text></view>
  <view class="ai-note"><text>✦</text><view><text class="strong">AI已识别以下字段</text><text class="muted small">请核对并补齐，发送前不会生成任何节点</text><text wx:if="{{confidenceLabel}}" class="ai-confidence">{{confidenceLabel}}</text></view></view>
  <view wx:if="{{needsClarification}}" class="card clarification-card">
    <view class="clarification-head"><view><text class="section-title">AI需要你确认</text><text class="muted small">回答后仅重新整理任务级字段</text></view><text class="question-count">{{aiQuestions.length}}项</text></view>
    <view wx:for="{{aiQuestions}}" wx:key="index" class="question-row"><text class="question-no">{{index + 1}}</text><text class="question-text">{{item}}</text></view>
    <textarea class="textarea clarification-input" value="{{clarificationText}}" bindinput="inputClarification" maxlength="1000" placeholder="补充AI需要确认的信息" />
    <button class="btn btn-secondary clarify-button" disabled="{{clarifying}}" bindtap="clarify">{{clarifying ? 'AI整理中…' : '提交回答，让AI继续整理'}}</button>
  </view>
  <view class="card form-card">
    <view class="field"><text class="label required">任务名称</text><input class="input" value="{{draft.taskName}}" data-field="taskName" bindinput="input" maxlength="50" /></view>
    <view class="field"><text class="label required">任务内容</text><textarea class="textarea" value="{{draft.taskDescription}}" data-field="taskDescription" bindinput="input" maxlength="1000" /></view>
    <view class="field"><text class="label required">任务目标</text><textarea class="textarea short" value="{{draft.taskGoal}}" data-field="taskGoal" bindinput="input" maxlength="500" /></view>
    <view class="field"><text class="label required">任务来源</text><input class="input" value="{{draft.taskSource}}" data-field="taskSource" bindinput="input" maxlength="120" /></view>
    <button class="menu-row" bindtap="openMetrics"><text class="menu-icon">✦</text><view class="menu-copy"><text class="strong">关联绩效指标</text><text class="muted small">系统候选，由创建人确认或不关联</text></view><text class="menu-value">{{draft.performanceMetric || '请选择'}}</text><text>›</text></button>
    <button class="menu-row" data-field="mainAssigneeEmployeeNo" bindtap="openPeople"><text class="menu-icon">人</text><view class="menu-copy"><text class="strong">主承办人 *</text><text class="muted small">搜索姓名/工号并查看负荷</text></view><text class="menu-value">{{assigneeName}}</text><text>›</text></button>
    <button class="menu-row" data-field="reportToEmployeeNo" bindtap="openPeople"><text class="menu-icon">报</text><view class="menu-copy"><text class="strong">汇报对象 *</text></view><text class="menu-value">{{reportToName}}</text><text>›</text></button>
    <button class="menu-row" data-field="reviewerEmployeeNo" bindtap="openPeople"><text class="menu-icon">验</text><view class="menu-copy"><text class="strong">验收人 *</text></view><text class="menu-value">{{reviewerName}}</text><text>›</text></button>
    <button class="menu-row" data-field="collaboratorEmployeeNos" bindtap="openPeople"><text class="menu-icon">协</text><view class="menu-copy"><text class="strong">协同人</text><text class="muted small">仅参与授权节点，不可接受主任务</text></view><text>›</text></button>
    <view wx:if="{{collaboratorDisplay.length}}" class="chips"><button wx:for="{{collaboratorDisplay}}" wx:key="employeeNo" class="chip" data-employee="{{item.employeeNo}}" bindtap="removeCollaborator">{{item.name}} ×</button></view>
    <view class="field"><text class="label required">开始时间</text><view class="two-col compact"><picker class="picker" mode="date" value="{{startDate}}" bindchange="chooseStartDate"><text>{{startDate}}</text></picker><picker class="picker" mode="time" value="{{startClock}}" bindchange="chooseStartTime"><text>{{startClock}}</text></picker></view></view>
    <view class="field"><text class="label required">截止时间</text><view class="two-col compact"><picker class="picker" mode="date" value="{{deadlineDate}}" bindchange="chooseDeadlineDate"><text>{{deadlineDate}}</text></picker><picker class="picker" mode="time" value="{{deadlineClock}}" bindchange="chooseDeadlineTime"><text>{{deadlineClock}}</text></picker></view></view>
    <view class="field"><text class="label required">任务权重</text><view class="weight-row"><button wx:for="{{weightOptions}}" wx:key="*this" class="weight {{draft.taskWeight === item ? 'selected' : ''}}" data-value="{{item}}" bindtap="chooseWeight">{{item}}</button></view></view>
    <view class="field"><text class="label">汇报周期</text><view class="picker"><text>每周 · 周五17:00</text></view></view>
    <view class="field"><text class="label">文字交付说明</text><textarea class="textarea short" value="{{draft.deliverable}}" data-field="deliverable" bindinput="input" maxlength="500" /></view>
    <view class="field"><text class="label">验收标准</text><textarea class="textarea short" value="{{draft.acceptanceCriteria}}" data-field="acceptanceCriteria" bindinput="input" maxlength="500" /></view>
    <view class="switch-row"><view><text class="strong">突发任务</text><text class="muted small">影响后续优先级/负荷计算</text></view><switch checked="{{draft.isUrgent}}" bindchange="toggleUrgent" color="#1769ff" /></view>
  </view>
  <view class="sticky-actions split"><button class="btn btn-secondary" disabled="{{saving}}" bindtap="saveDraft">保存草稿</button><button class="btn btn-primary" disabled="{{saving}}" loading="{{saving}}" bindtap="next">进入发送确认 →</button></view>

  <view wx:if="{{peopleSheet}}" class="overlay" bindtap="closePeople"><view class="sheet" catchtap="noop"><view class="sheet-head"><text class="sheet-title">{{peopleTitle}}</text><button class="close" bindtap="closePeople">×</button></view><input class="input" placeholder="搜索姓名或员工号" value="{{peopleKeyword}}" bindinput="searchPeople"/><view class="people-list"><button wx:for="{{filteredUsers}}" wx:key="employeeNo" class="person-row" data-employee="{{item.employeeNo}}" bindtap="selectPerson"><view class="avatar">{{item.avatar}}</view><view class="person-copy"><text class="strong">{{item.name}}</text><text class="muted small">{{item.employeeNo}} · {{item.departmentName || '-'}}</text></view><text class="load {{item.workloadScore > 75 ? 'high' : item.workloadScore < 50 ? 'low' : ''}}">{{item.workloadLevel || '暂无'}} {{item.workloadScore || ''}}</text></button><view wx:if="{{!filteredUsers.length}}" class="empty">没有可选择的人员</view></view></view></view>
  <view wx:if="{{metricSheet}}" class="overlay" bindtap="closeMetrics"><view class="sheet" catchtap="noop"><view class="sheet-head"><text class="sheet-title">选择绩效指标</text><button class="close" bindtap="closeMetrics">×</button></view><text class="muted small">系统按任务内容生成候选，仍需创建人确认。</text><view wx:if="{{metricLoading}}" class="empty">正在计算候选指标…</view><button class="person-row" bindtap="chooseNoMetric"><view class="person-copy"><text class="strong">不关联绩效指标</text><text class="muted small">本任务不计入具体绩效指标</text></view></button><button wx:for="{{metricMatches}}" wx:key="performanceMatchId" class="person-row" data-match="{{item.performanceMatchId}}" bindtap="selectMetric"><view class="menu-icon">✦</view><view class="person-copy"><text class="strong">{{item.metricName || item.metricId}}</text><text class="muted small">{{item.matchReason || item.matchLevel}}</text></view><text class="load low">{{item.totalScore}}分</text></button></view></view>
</view>
