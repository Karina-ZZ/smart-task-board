<view class="page no-nav"><view class="safe-top"></view><view class="topbar topbar-left"><button class="back" bindtap="back">‹</button><view><text class="eyebrow">WORKLOAD DRILLDOWN</text><text class="title">员工负荷任务</text><text class="subtitle">{{snapshotId}} · {{member.departmentName}}</text></view></view>
  <view class="member-card"><view class="member-head"><view class="member-avatar">{{member.avatarText}}</view><view><text class="member-name">{{member.name}}</text><text class="member-meta">{{member.employeeNo}} · {{member.workloadLevel}}</text></view><view class="score"><text class="bold">{{member.workloadScore}}</text><text>综合负荷</text></view></view><view class="line"></view><view wx:for="{{pressures}}" wx:key="label" class="pressure"><view><text>{{item.label}}</text><text class="bold">{{item.value}}</text></view><view class="progress"><view class="progress-fill {{item.value >= 80 ? 'red' : ''}}" style="width: {{item.value}}%"></view></view></view></view>
  <view class="section-head"><text class="section-title">纳入本次负荷的任务</text><text class="badge blue">{{tasks.length}} 项</text></view><view class="scope-note">筛选条件：{{member.departmentName}} / {{member.name}} / 当前快照。点击任务可进入单任务详情。</view>
  <view wx:if="{{!tasks.length}}" class="card empty"><text class="empty-mark">○</text><text>该快照没有纳入任务</text></view><task-card wx:for="{{tasks}}" wx:key="taskId" task="{{item}}" bind:open="openTask" />
</view>
