/**
 * Feature: Second-version visual foundation.
 * Responsibilities: define the mobile palette, typography, spacing, cards, buttons and feedback states.
 * Does not own: page-specific layout or business visibility.
 * Plan task: WECHAT-MP-01.
 */

page {
  --blue: #1769ff;
  --blue-2: #4b8cff;
  --navy: #071d3d;
  --teal: #08a99a;
  --red: #ff4358;
  --orange: #ff9718;
  --ink: #11203a;
  --muted: #72809a;
  --line: #e7edf6;
  --bg: #f4f7fc;
  --card: #ffffff;
  min-height: 100%;
  color: var(--ink);
  background: linear-gradient(145deg, #eef4fb 0%, #f7f9fd 42%, #e9eff8 100%);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

button { margin: 0; padding: 0; border-radius: 0; background: transparent; color: inherit; font-size: inherit; line-height: inherit; }
button::after { border: 0; }
input, textarea, picker { font-size: 28rpx; }

.page { min-height: 100vh; padding: 0 28rpx calc(152rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.page.no-nav { padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); }
.safe-top { height: calc(env(safe-area-inset-top) + 18rpx); }
.topbar { display: flex; align-items: center; justify-content: space-between; min-height: 88rpx; }
.topbar-main { min-width: 0; }
.eyebrow { color: var(--blue); font-size: 22rpx; font-weight: 700; letter-spacing: 3rpx; }
.title { display: block; margin-top: 4rpx; font-size: 42rpx; font-weight: 800; letter-spacing: -1rpx; line-height: 1.18; }
.subtitle { display: block; margin-top: 8rpx; color: var(--muted); font-size: 24rpx; }
.back { display: flex; align-items: center; justify-content: center; width: 72rpx; height: 72rpx; margin-right: 12rpx; border-radius: 50%; background: rgba(255,255,255,.9); box-shadow: 0 12rpx 28rpx rgba(28,65,121,.09); font-size: 36rpx; }
.topbar-left { display: flex; align-items: center; min-width: 0; }

.card { margin-top: 22rpx; padding: 28rpx; border: 1rpx solid rgba(231,237,246,.9); border-radius: 32rpx; background: rgba(255,255,255,.96); box-shadow: 0 18rpx 60rpx rgba(28,65,121,.08); box-sizing: border-box; }
.section-head { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; margin: 32rpx 4rpx 12rpx; }
.section-title { font-size: 30rpx; font-weight: 800; }
.section-link { min-height: 64rpx; padding: 0 16rpx; color: var(--blue); font-size: 24rpx; font-weight: 700; }
.muted { color: var(--muted); }
.small { font-size: 23rpx; }
.strong { font-weight: 800; }
.bold { font-weight: 800; }
.line { height: 1rpx; margin: 24rpx 0; background: var(--line); }

.btn { display: flex; align-items: center; justify-content: center; min-height: 92rpx; padding: 0 28rpx; border-radius: 26rpx; font-weight: 800; box-sizing: border-box; }
.btn-primary { color: #fff; background: linear-gradient(135deg, var(--blue), var(--blue-2)); box-shadow: 0 16rpx 32rpx rgba(23,105,255,.24); }
.btn-secondary { color: var(--blue); border: 2rpx solid #bad0ff; background: #f5f8ff; }
.btn-danger { color: var(--red); border: 2rpx solid #ffd0d7; background: #fff7f8; }
.btn-row { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; margin-top: 24rpx; }
.sticky-actions { position: sticky; bottom: 20rpx; z-index: 5; margin-top: 28rpx; padding: 18rpx; border-radius: 32rpx; background: rgba(255,255,255,.92); box-shadow: 0 16rpx 44rpx rgba(25,57,108,.16); backdrop-filter: blur(18rpx); }

.badge { display: inline-flex; align-items: center; min-height: 44rpx; padding: 0 16rpx; border-radius: 99rpx; color: #24508d; background: #edf4ff; font-size: 22rpx; font-weight: 700; }
.badge.blue { color: #1459d2; background: #e9f1ff; }
.badge.green { color: #087d72; background: #e7fbf7; }
.badge.orange { color: #ad5b00; background: #fff2df; }
.badge.red { color: #c52c42; background: #ffedf0; }
.badge.gray { color: #61708a; background: #f0f3f8; }

.field { margin-top: 24rpx; }
.label { display: block; margin-bottom: 12rpx; font-size: 25rpx; font-weight: 800; }
.required::after { content: " *"; color: var(--red); }
.input, .textarea, .picker { width: 100%; min-height: 88rpx; padding: 22rpx 24rpx; border: 2rpx solid var(--line); border-radius: 22rpx; background: #f9fbfe; box-sizing: border-box; }
.textarea { min-height: 190rpx; line-height: 1.65; }
.picker { display: flex; align-items: center; justify-content: space-between; }
.hint { display: block; margin-top: 10rpx; color: var(--muted); font-size: 22rpx; line-height: 1.55; }
.error { color: var(--red); }

.metric-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18rpx; }
.metric { padding: 24rpx; border-radius: 26rpx; background: #f7faff; }
.metric-value { display: block; margin-top: 8rpx; font-size: 48rpx; font-weight: 900; line-height: 1; }
.progress { height: 12rpx; overflow: hidden; border-radius: 99rpx; background: #e7edf6; }
.progress-fill { height: 100%; border-radius: inherit; background: linear-gradient(90deg, var(--blue), var(--teal)); }
.empty { padding: 62rpx 22rpx; text-align: center; color: var(--muted); }
.empty-mark { display: block; margin-bottom: 16rpx; color: #b7c5d8; font-size: 64rpx; }
.toast-safe { padding-bottom: env(safe-area-inset-bottom); }
