# Test14 isolated local Web config. No real credentials; NOT a production config.
# Copy outside the repository; replace passwords and verify the NEW disposable DB.
# 46480 is a proposed separate live-test port, not a claim of successful execution.
APP_NAME=Smart Task Board API - Test14 local
APP_ENV=development
APP_DEBUG=false
APP_TIMEZONE=Asia/Shanghai
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://smarttaskboard_test:replace-with-test14-password@127.0.0.1:46480/smart_task_board_test14_test
DATABASE_CONNECT_TIMEOUT_SECONDS=5
AUTH_MODE=prototype
PROTOTYPE_AUTH_ENABLED=true
PROTOTYPE_USER_EMPLOYEE_NOS=E-CREATOR,E-ASSIGNEE,E-REVIEWER,E-OBSERVER
ALLOW_TEST_EMPLOYEE_HEADER=false
JWT_SECRET_KEY=replace-with-at-least-32-random-test14-characters
JWT_ISSUER=smart-task-board
JWT_AUDIENCE=smart-task-board-web
JWT_EXPIRE_MINUTES=30
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5174,http://localhost:5174
# Login/contract tests do not call a live provider. Real AI acceptance is separate.
AI_PROVIDER=fake
