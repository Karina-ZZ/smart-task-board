# 旺序AI任务中枢 Web 本地演示登录配置模板
# 仅用于隔离的本地/验收环境。不要覆盖正式企业微信 backend.env。
# 复制到仓库外，例如 /tmp/stb-web-demo.env，再填写测试数据库密码和 JWT。

APP_NAME=Smart Task Board API
APP_ENV=development
APP_DEBUG=false
APP_TIMEZONE=Asia/Shanghai
LOG_LEVEL=INFO

# 隔离演示 PostgreSQL。以下端口 46479 对应 2026-09-07 Test11 本地验收环境示例；
# 如果你的测试库端口不同，请修改 DATABASE_URL。
DATABASE_URL=postgresql+psycopg://smart_task_board:replace-with-demo-password@127.0.0.1:46479/smart_task_board_demo
DATABASE_CONNECT_TIMEOUT_SECONDS=5

# Web 本地演示必须使用 prototype；正式企业微信环境继续使用 wecom，禁止共用此文件。
AUTH_MODE=prototype
PROTOTYPE_AUTH_ENABLED=true
PROTOTYPE_USER_EMPLOYEE_NOS=E-CREATOR,E-ASSIGNEE,E-REVIEWER,E-OBSERVER
ALLOW_TEST_EMPLOYEE_HEADER=false

# 至少32字符，仅限隔离演示环境。
JWT_SECRET_KEY=replace-with-at-least-32-random-demo-characters
JWT_ISSUER=smart-task-board
JWT_AUDIENCE=smart-task-board-web
JWT_EXPIRE_MINUTES=30

# 与 scripts/start-web-demo.sh 默认的前端 5174 对齐。
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5174,http://localhost:5174

# Web 登录联调不依赖公网 LLM；保持 fake，避免误发外部请求。
AI_PROVIDER=fake
