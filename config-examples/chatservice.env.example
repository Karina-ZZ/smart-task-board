# 旺序任务中枢 ChatService 本地/服务器配置模板
# 复制为 secrets/chatservice.env（本地）或 /etc/wangxu/chatservice.env（服务器）后填写真实值。

APP_ENV=development
CHAT_REQUIRE_AUTH=true

# 必须与 backend.env 中 CHAT_SERVICE_JWT_SECRET_KEY 完全一致。
CHAT_SERVICE_JWT_SECRET_KEY=replace-with-a-different-32-plus-character-random-secret
CHAT_SERVICE_JWT_ISSUER=smart-task-board
CHAT_SERVICE_JWT_AUDIENCE=wangxu-chat

# 通义千问 / DashScope
DASHSCOPE_API_KEY=replace-with-your-dashscope-api-key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
QWEN_ASR_MODEL=
QWEN_TIMEOUT_SECONDS=30

# ChatService 可选 MySQL 会话/LLM审计库；不保存任务业务真数据。
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
