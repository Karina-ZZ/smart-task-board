# 旺序任务中枢 FastAPI 本地/服务器配置模板
# 复制为 secrets/backend.env（本地）或 /etc/wangxu/backend.env（服务器）后填写真实值。

APP_NAME=Smart Task Board API
APP_ENV=development
APP_DEBUG=false
APP_TIMEZONE=Asia/Shanghai
LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_DB=smart_task_board
POSTGRES_USER=smart_task_board
POSTGRES_PASSWORD=replace-with-strong-database-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://smart_task_board:replace-with-strong-database-password@127.0.0.1:5432/smart_task_board

# 正式企业微信登录
AUTH_MODE=wecom
ALLOW_TEST_EMPLOYEE_HEADER=false
PROTOTYPE_AUTH_ENABLED=false
PROTOTYPE_USER_EMPLOYEE_NOS=
WECOM_CORP_ID=replace-with-wecom-corp-id
WECOM_AGENT_ID=replace-with-wecom-agent-id
WECOM_APP_SECRET=replace-with-wecom-app-secret
WECOM_API_BASE_URL=https://qyapi.weixin.qq.com
WECOM_REQUEST_TIMEOUT_SECONDS=8

# 旺序业务会话。请生成至少32字符随机值。
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ISSUER=smart-task-board
JWT_AUDIENCE=smart-task-board-web
JWT_EXPIRE_MINUTES=30

# FastAPI -> ChatService 的短时 AI Token。
# CHAT_SERVICE_JWT_SECRET_KEY 必须与 chatservice.env 中同名字段保持完全一致。
CHAT_SERVICE_JWT_SECRET_KEY=replace-with-a-different-32-plus-character-random-secret
CHAT_SERVICE_JWT_ISSUER=smart-task-board
CHAT_SERVICE_JWT_AUDIENCE=wangxu-chat
CHAT_SERVICE_JWT_EXPIRE_MINUTES=5

CORS_ALLOWED_ORIGINS=http://localhost:5173

# 后端 AI provider 保持项目现有配置；任务录入 Qwen Key 在 chatservice.env 中维护。
AI_PROVIDER=fake
