[Unit]
Description=Wangxu ChatService
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wangxu
Group=wangxu
WorkingDirectory=/opt/wangxu/current/cloud-functions/ChatService
Environment=WANGXU_CHAT_ENV_FILE=/etc/wangxu/chatservice.env
ExecStart=/opt/wangxu/chat-venv/bin/gunicorn --bind 127.0.0.1:9000 --workers 2 --threads 4 --timeout 60 app:app
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
