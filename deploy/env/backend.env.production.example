# RELEASE-01 production template. Copy to /etc/wangxu/backend.env and replace every placeholder.
APP_NAME=Smart Task Board API
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Asia/Shanghai
LOG_LEVEL=INFO

POSTGRES_DB=smart_task_board
POSTGRES_USER=smart_task_board
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DATABASE_PASSWORD
POSTGRES_PORT=5432
# In production Compose, use the internal service hostname "postgres".
DATABASE_URL=postgresql+psycopg://smart_task_board:REPLACE_WITH_STRONG_DATABASE_PASSWORD@postgres:5432/smart_task_board
DATABASE_CONNECT_TIMEOUT_SECONDS=5

AUTH_MODE=wecom
ALLOW_TEST_EMPLOYEE_HEADER=false
PROTOTYPE_AUTH_ENABLED=false
PROTOTYPE_USER_EMPLOYEE_NOS=
WECOM_CORP_ID=REPLACE_WITH_WECOM_CORP_ID
WECOM_AGENT_ID=REPLACE_WITH_WECOM_AGENT_ID
WECOM_APP_SECRET=REPLACE_WITH_WECOM_APP_SECRET
WECOM_API_BASE_URL=https://qyapi.weixin.qq.com
WECOM_REQUEST_TIMEOUT_SECONDS=8

JWT_SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_ISSUER=smart-task-board
JWT_AUDIENCE=smart-task-board-web
JWT_EXPIRE_MINUTES=30

# Must equal the same field in chatservice.env. Do NOT reuse JWT_SECRET_KEY.
CHAT_SERVICE_JWT_SECRET_KEY=REPLACE_WITH_DIFFERENT_32_PLUS_RANDOM_SECRET
CHAT_SERVICE_JWT_ISSUER=smart-task-board
CHAT_SERVICE_JWT_AUDIENCE=wangxu-chat
CHAT_SERVICE_JWT_EXPIRE_MINUTES=5

# For mini-program-only production this may be empty. If Web is exposed, list exact HTTPS origins.
CORS_ALLOWED_ORIGINS=

AI_PROVIDER=fake
