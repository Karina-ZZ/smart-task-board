# RELEASE-01 production template. Copy to /etc/wangxu/chatservice.env and replace placeholders.
APP_ENV=production
CHAT_REQUIRE_AUTH=true

# Must exactly match backend.env CHAT_SERVICE_JWT_SECRET_KEY.
CHAT_SERVICE_JWT_SECRET_KEY=REPLACE_WITH_DIFFERENT_32_PLUS_RANDOM_SECRET
CHAT_SERVICE_JWT_ISSUER=smart-task-board
CHAT_SERVICE_JWT_AUDIENCE=wangxu-chat

DASHSCOPE_API_KEY=REPLACE_WITH_DASHSCOPE_API_KEY
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
QWEN_ASR_MODEL=
QWEN_TIMEOUT_SECONDS=30

# Optional. Leave empty when ChatService conversation/audit MySQL is not enabled.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
